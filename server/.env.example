# CoverageIQ Node.js Express API Gateway Environment Configuration
NODE_ENV=development
SERVER_PORT=8000
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Shared Redis 7 (distributed atomic upload rate limiting + health checks)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=2000

# Internal FastAPI AI Service (Node dispatches identifier-only enqueue requests here)
AI_SERVICE_URL=http://127.0.0.1:8001
INTERNAL_SERVICE_TOKEN=
ENQUEUE_HTTP_TIMEOUT_MS=5000
ENQUEUE_INLINE_ATTEMPTS=2
ENQUEUE_RECONCILE_INTERVAL_MS=15000
ENQUEUE_MAX_DISPATCH_ATTEMPTS=5
QA_HTTP_TIMEOUT_MS=90000
RECOMMENDATION_HTTP_TIMEOUT_MS=45000

# PostgreSQL 16 Database (node-pg-migrate owns SQL migrations in server/)
# Use a least-privilege DML-only runtime role for application queries,
# and a separate schema-owner migration role for node-pg-migrate.
DATABASE_URL=postgresql://coverageiq_runtime:change_me_runtime@localhost:5432/coverageiq_db
MIGRATION_DATABASE_URL=postgresql://coverageiq_migrator:change_me_migrator@localhost:5432/coverageiq_db
POLICY_UPLOAD_ROOT=./uploads/policies
MAX_PDF_SIZE_BYTES=26214400
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=30

# JWT Authentication (reused by auth.middleware.js & user.controller.js)
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=1d
