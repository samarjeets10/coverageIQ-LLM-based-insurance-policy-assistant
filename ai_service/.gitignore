# ==============================================================================
# CoverageIQ - AI Service Git Ignore Configuration
# Preserves upstream M2/M3/M7/M8 ignore rules while narrowly tracking required
# M5 baseline LightGBM artifacts and documented SQL design proposals.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Testing Database & Storage (Prevent conflicts with Primary DB)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql
!sql/
sql/*
!sql/proposed_003_recommendation_schema.sql
!sql/proposed_003_recommendation_schema_v2.sql
!sql/proposed_003_recommendation_schema_v3.sql
*.duckdb
*.parquet
data/
db/
test_db/
local_storage/
postgres_data/

# ------------------------------------------------------------------------------
# 2. Python Bytecode, Compilations & Runtime Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------------------------------------------
# 3. Automated Testing, Linting & Coverage Reports
# ------------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 4. Local Environment Secrets & Configuration
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------------------------
# 5. ML Models, Checkpoints & Artifacts (Narrow exception for 3 M5 model files)
# ------------------------------------------------------------------------------
/models/
checkpoints/
huggingface/
.cache/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
artifacts/*
!artifacts/models/
artifacts/models/*
!artifacts/models/lightgbm_ranker.joblib
!artifacts/models/lightgbm_metadata.json
!artifacts/models/training_metrics.json

# ------------------------------------------------------------------------------
# 6. Logs, Build Outputs, Test PDFs & Temporary Ingestion Artifacts
# ------------------------------------------------------------------------------
logs/
*.log
build/
dist/
*.egg-info/
*.pdf
uploads/
temp/
tmp/
scratch/

# ------------------------------------------------------------------------------
# 7. Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 8. Editor & OS Specific Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
