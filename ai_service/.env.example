# Example environment configuration for CoverageIQ AI Service (Internal FastAPI)
APP_ENV=development
HOST=127.0.0.1
PORT=8001
DEBUG=true

# Internal Gateway Authentication & Policy Storage
# In multi-host deployments, point POLICY_UPLOAD_ROOT (or a shared mount / object storage backend)
# to storage accessible by both Node.js API gateway and Celery workers.
INTERNAL_SERVICE_TOKEN=
INTERNAL_CORS_ORIGINS=
POLICY_UPLOAD_ROOT=./uploads/policies

# Database (PostgreSQL 16 + pgvector; schema migrations owned by Node.js via node-pg-migrate)
# Point runtime DATABASE_URL to the least-privilege runtime role (DML only, never the migration owner role).
# Non-test environments (APP_ENV=production/staging or DEBUG=false) fail closed if USE_MOCK_STORAGE is true or unset.
USE_MOCK_STORAGE=false
DATABASE_URL=postgresql://coverageiq_runtime:change_me_runtime@localhost:5432/coverageiq_db
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=30.0

# Redis & Celery Async Ingestion
# Default concurrency=1 and ingestion embedding batch=1 target safe execution on 4 GB VRAM GPUs.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_INGESTION_QUEUE=ingestion
CELERY_OCR_QUEUE=ocr
CELERY_WORKER_CONCURRENCY=1
CELERY_INGESTION_EMBEDDING_BATCH_SIZE=1
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_BASE=5
CELERY_TASK_RETRY_BACKOFF_MAX=300
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360

# Embeddings & Retrieval (BAAI/bge-m3, 1024 dimensions, pgvector HNSW)
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=4
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true
EMBEDDING_LOCAL_FILES_ONLY=false
PGVECTOR_HNSW_EF_SEARCH=40
PGVECTOR_HNSW_ITERATIVE_SCAN=relaxed_order

# LLM Provider (NVIDIA Nemotron)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_SECONDS=60.0
NVIDIA_MAX_RETRIES=2
NVIDIA_MAX_TOKENS=8192
NVIDIA_TEMPERATURE=1.0
