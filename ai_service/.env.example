# FastAPI AI Service Configuration
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_ENV=development
# Shared internal service token expected in X-Service-Token header (leave empty to disable in local dev)
AI_SERVICE_TOKEN=

# PostgreSQL Connection (matches server/.env variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coverageiq_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Recommendation ML Artifacts
MODEL_ARTIFACTS_DIR=artifacts/models
