# Example environment configuration for CoverageIQ AI Service (Internal FastAPI)
HOST=127.0.0.1
PORT=8001
DEBUG=true

# Internal Gateway Authentication & Policy Storage
INTERNAL_SERVICE_TOKEN=
POLICY_UPLOAD_ROOT=./uploads/policies

# Database (PostgreSQL 16 + pgvector; schema migrations owned by Node.js via node-pg-migrate)
USE_MOCK_STORAGE=true
DATABASE_URL=postgresql://coverageiq:coverageiq@localhost:5432/coverageiq_db
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=30.0

# Redis & Celery Async Ingestion
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Embeddings (BAAI/bge-m3, 1024 dimensions)
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=4
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true
EMBEDDING_LOCAL_FILES_ONLY=false

# LLM Provider (NVIDIA Nemotron)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_SECONDS=60.0
NVIDIA_MAX_RETRIES=2
NVIDIA_MAX_TOKENS=8192
NVIDIA_TEMPERATURE=1.0
